{
  "_comment": "难度/分类录入规则。依据 developer.md：difficulty 取 易/中/难（编辑最终确认）；filterMetadata.categories 取 优选题/易错题；difficultyValue 0~1（>=0.8 容易、>=0.5 适中、其余困难）。文档 L332 明确「未知值留空，不要根据题型猜造标注」，所以这里按可观测特征打分并输出依据，类型只作微调先验。",
  "doc_constraints": {
    "difficulty_field": [
      "易",
      "中",
      "难"
    ],
    "categories": [
      "优选题",
      "易错题"
    ],
    "difficulty_value_bands": {
      "容易": 0.8,
      "适中": 0.5
    },
    "no_guessing": "特征不足时留空（difficultyValue=null），列入待编辑清单，不按题型硬填。",
    "patch_replaces": "PATCH filterMetadata 整体替换，补标签必须先读原值再合并。"
  },
  "feature_scoring": {
    "start": 0.75,
    "rules": [
      {
        "feature": "word_count",
        "lt": 80,
        "delta": 0.08,
        "basis": "词数少（<80）"
      },
      {
        "feature": "word_count",
        "gte": 80,
        "lt": 160,
        "delta": 0.03,
        "basis": "词数中等（80-160）"
      },
      {
        "feature": "word_count",
        "gte": 320,
        "delta": -0.08,
        "basis": "词数多（>=320）"
      },
      {
        "feature": "avg_sentence_len",
        "gte": 20,
        "delta": -0.06,
        "basis": "平均句长偏长（>=20 词）"
      },
      {
        "feature": "long_word_ratio",
        "gte": 0.18,
        "delta": -0.05,
        "basis": "长词比例高（>=0.18）"
      },
      {
        "feature": "option_homogeneous",
        "eq": true,
        "delta": -0.05,
        "basis": "选项长度/形式高度一致，干扰强"
      }
    ],
    "knowledge_rules": [
      {
        "when_knowledge_any": [
          "阅读技能/推理判断",
          "阅读技能/主旨大意",
          "阅读技能/最佳标题",
          "阅读技能/写作手法",
          "阅读技能/观点态度"
        ],
        "delta": -0.12,
        "basis": "设问需推断/概括"
      },
      {
        "when_knowledge_any": [
          "阅读技能/猜测词义",
          "阅读技能/代词指代",
          "阅读技能/篇章结构"
        ],
        "delta": -0.06,
        "basis": "需语境推断"
      },
      {
        "when_knowledge_any": [
          "词汇/词汇辨析"
        ],
        "delta": -0.08,
        "basis": "四选项同词性近义"
      },
      {
        "when_knowledge_any": [
          "语法/主从复合句",
          "语法/动词的非谓语形式",
          "语法/谓语动词的时态和语态/被动语态"
        ],
        "delta": -0.06,
        "basis": "从句/非谓语/被动，句法负担重"
      },
      {
        "when_knowledge_any": [
          "词汇/构词法"
        ],
        "delta": -0.04,
        "basis": "需构词变形"
      },
      {
        "when_knowledge_any": [
          "阅读技能/细节理解",
          "阅读技能/图片理解"
        ],
        "delta": 0.06,
        "basis": "定位即可作答"
      }
    ],
    "type_prior": {
      "_comment": "只做 ±0.05 的微调，不能单独定档；类型本身不是难度证据。",
      "单词拼写": 0.04,
      "补全对话": 0.04,
      "听力短对话理解": 0.04,
      "改错": -0.04,
      "短文填空": -0.04,
      "读写综合": -0.04,
      "任务型阅读": -0.03
    },
    "no_evidence_types": [
      "听力短对话理解",
      "听力长对话理解",
      "听力短文理解",
      "听力信息转换",
      "听力判断",
      "听力排序",
      "听力问答",
      "语音题"
    ],
    "no_evidence_note": "听力/语音只有音频、没有材料文本时无法计算词数与句长，留空待人工；有听力稿则可按文本算。",
    "prompt_only_types": {
      "_comment": "这些题型的正文就是「题目要求」，不是阅读量，不能用词数判难度，直接给基准值。",
      "书面表达": 0.6,
      "读写综合": 0.58,
      "翻译": 0.6,
      "完成句子": 0.62,
      "改错": 0.55,
      "情景运用": 0.66,
      "单词拼写": 0.74
    },
    "audio_duration_scoring": {
      "_comment": "没有听力稿时，用音频时长作负荷代理（越长信息量越大）。这是可观测证据，不是按题型猜。",
      "bands": [
        {
          "lt": 20,
          "value": 0.9,
          "basis": "音频 <20s"
        },
        {
          "lt": 35,
          "value": 0.85,
          "basis": "音频 20-35s"
        },
        {
          "lt": 60,
          "value": 0.8,
          "basis": "音频 35-60s"
        },
        {
          "lt": 90,
          "value": 0.76,
          "basis": "音频 60-90s"
        },
        {
          "lt": 9999,
          "value": 0.72,
          "basis": "音频 >90s"
        }
      ]
    },
    "composite_rules": [
      {
        "all": [
          {
            "word_count_gte": 320
          },
          {
            "when_knowledge_any": [
              "阅读技能/推理判断",
              "阅读技能/主旨大意",
              "阅读技能/最佳标题",
              "阅读技能/写作手法"
            ]
          }
        ],
        "delta": -0.06,
        "basis": "长文（>=320 词）且需推断/概括"
      },
      {
        "all": [
          {
            "word_count_gte": 320
          },
          {
            "when_knowledge_any": [
              "阅读技能/猜测词义",
              "阅读技能/代词指代",
              "阅读技能/篇章结构"
            ]
          }
        ],
        "delta": -0.04,
        "basis": "长文且需语境推断"
      }
    ]
  },
  "categories": {
    "易错题": {
      "when_knowledge_any": [
        "词汇/词汇辨析",
        "词汇/短语与固定搭配",
        "语法/谓语动词的时态和语态",
        "语法/主从复合句",
        "语法/动词的非谓语形式"
      ],
      "when_option_homogeneous": true,
      "basis": "同词性近义干扰、搭配误用、时态/从句陷阱",
      "when_option_homogeneous_types": [
        "单项填空",
        "语法选择",
        "选词填空",
        "完成句子"
      ]
    },
    "优选题": {
      "when_knowledge_any": [
        "阅读技能/推理判断",
        "阅读技能/主旨大意",
        "阅读技能/最佳标题",
        "阅读技能/写作手法",
        "阅读技能/观点态度"
      ],
      "when_types": [
        "书面表达",
        "读写综合",
        "任务型阅读"
      ],
      "basis": "设问有区分度，能考出思维层次"
    }
  },
  "review_note": "写入的是 AI 初判值，交接单需列出每条的依据与「待编辑确认」清单；编辑用 filterMetadataStored 复核后再定稿。"
}